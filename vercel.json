{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://sdk.cashfree.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://res.cloudinary.com https://images.unsplash.com https://*.cashfree.com; connect-src 'self' https://api.cashfree.com https://sandbox.cashfree.com https://*.cashfree.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://*.firebaseio.com https://*.firebasestorage.app https://res.cloudinary.com https://api.cloudinary.com; frame-src 'self' https://sdk.cashfree.com https://api.cashfree.com https://sandbox.cashfree.com https://*.cashfree.com https://api.razorpay.com https://*.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self';"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/check-email",
      "destination": "/api/auth?action=check-email"
    },
    {
      "source": "/api/send-otp",
      "destination": "/api/auth?action=send-otp"
    },
    {
      "source": "/api/verify-otp",
      "destination": "/api/auth?action=verify-otp"
    },
    {
      "source": "/api/sign-cloudinary",
      "destination": "/api/cloudinary"
    },
    {
      "source": "/api/upload-image",
      "destination": "/api/cloudinary"
    },
    {
      "source": "/api/calculate-order-summary",
      "destination": "/api/order?action=calculate-summary"
    },
    {
      "source": "/api/create-order",
      "destination": "/api/order?action=create"
    },
    {
      "source": "/api/update-order-admin",
      "destination": "/api/order?action=update-admin"
    },
    {
      "source": "/api/sync-guest-orders",
      "destination": "/api/order?action=sync-guest"
    },
    {
      "source": "/api/create-cashfree-order",
      "destination": "/api/payment?action=create-order"
    },
    {
      "source": "/api/verify-cashfree-payment",
      "destination": "/api/payment?action=verify-payment"
    },
    {
      "source": "/api/generate-payment-link",
      "destination": "/api/payment?action=generate-link"
    },
    {
      "source": "/api/record-manual-payment",
      "destination": "/api/payment?action=record-manual"
    },
    {
      "source": "/api/manage-installment-schedule",
      "destination": "/api/payment?action=manage-schedule"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}