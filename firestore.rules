rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user has admin claim
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    // Function to check if OTP was verified for this session
    function isOtpVerified() {
      return request.auth != null && request.auth.token.otpVerifiedAt >= request.auth.token.auth_time;
    }

    // ── PRODUCTS COLLECTION ──
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── CATEGORIES & SITE SETTINGS ──
    match /site_settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage_categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── CLOUDINARY MEDIA MANAGER ──
    match /media_assets/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── USERS COLLECTION ──
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId && isOtpVerified();
      allow create: if request.auth != null && request.auth.uid == userId && isOtpVerified()
                    && !('role' in request.resource.data) && !('admin' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId && isOtpVerified()
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'permissions']));
      allow read, write: if isAdmin();
    }

    // ── ORDERS COLLECTION ──
    match /orders/{documentId} {
      // Users can read their own verified orders. 
      // Guests can read ONLY if they know the exact unguessable documentId (get).
      allow get: if (request.auth != null && resource.data.userId == request.auth.uid && isOtpVerified())
                    || resource.data.isGuest == true
                    || isAdmin();
      
      // Prevent querying (list) unless authenticated or querying own user ID
      allow list: if (request.auth != null && resource.data.userId == request.auth.uid && isOtpVerified())
                     || isAdmin();
                     
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ── OTPS COLLECTION ──
    match /otps/{email} {
      allow read, write: if false; // Only server functions update OTPs
    }

    // ── ADMIN LOGS & AUTH SECURITY ──
    match /authSecurity/{ipHash} {
      allow read, write: if false; // strictly server side proxy
    }
    
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Created via proxy server
    }

    // ── DESIGN REQUESTS COLLECTION ──
    match /design_requests/{requestId} {
      allow read: if request.auth != null || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

  }
}
